#!/bin/bash
# After a double-click install, open Escape Engine so the first-run guide appears.
# Skipped for command-line installs (e.g. CI); never fails the install.
if [ -z "${COMMAND_LINE_INSTALL:-}" ]; then
  user="$(stat -f%Su /dev/console 2>/dev/null || true)"
  if [ -n "$user" ] && [ "$user" != "root" ]; then
    launchctl asuser "$(id -u "$user")" sudo -u "$user" open "/Applications/Escape Engine.app" || true
  fi
fi
exit 0
